# Build tasks. Run from the repository root:
#
#   nim test    unit tests (C backend)
#   nim build   tests, then compile the app to JS and write index.html
#   nim icons   trace the biome icons from the rulebook image (needs ImageMagick, potrace)
#   nim plates  laser-cutting SVGs for the symbol plates (hardware/plates/)
#   nim sim     simulate the analog chain in ngspice and compare with the app's maths
#   nim results run every simulation; write CSVs, SVG charts and a report to
#               hardware/results/ (needs ngspice)
#
# index.html is self-contained: the stylesheet and compiled app are inlined.

import "src/page.nim"
import "hardware/plates.nim"
import "hardware/simgen.nim", "hardware/experiments.nim", "hardware/charts.nim"
import "src/model.nim", "src/odds.nim"
import std/[math, strutils, tables]

const
  AppJs = "build/app.js"
  Page = "index.html"

task test, "Run the unit tests":
  for test in ["tests/test_odds.nim", "tests/test_plates.nim"]:
    exec "nim c -r --hints:off --outdir:build/tests " & test

task build, "Test, compile the app to JavaScript and write " & Page:
  exec "nim test"
  exec "nim js -d:release --hints:off -o:" & AppJs & " src/app.nim"
  writeFile(Page, renderPage(css = readFile("src/style.css"),
                             appJs = readFile(AppJs)))
  echo "wrote ", Page

task plates, "Write laser-cutting SVGs for the plates to hardware/plates/":
  const dir = "hardware/plates/"
  mkDir dir
  let plates = allPlates()
  for plate in plates:
    writeFile(dir & plate.fileName, plate.plateSvg)
  writeFile(dir & "sheet.svg", plates.sheetSvg)
  echo "wrote ", plates.len, " plates and sheet.svg to ", dir

task sim, "Simulate the analog chain (ngspice) against the app's maths":
  # (stacked symbols, blank card counts as safe, cards played, danger cards played)
  const scenarios = [
    ({Void}, false, 0, 0),
    ({Void, Caves}, true, 10, 3),
    ({Rocky, Desert, Caves}, false, 20, 5),
    ({Ruins}, true, 37, 1),
    ({Void .. Desert}, false, 0, 0),
    ({Hostile, Crystalline}, false, 30, 27)]
  var worst = 0.0
  for (symbols, blankSafe, played, dangerPlayed) in scenarios:
    var stack: seq[Plate]
    for symbol in symbols: stack.add plateFor(symbol)
    if blankSafe: stack.add blankSafePlate()
    let rule = if blankSafe: blankIsSafe else: blankIsDanger
    let safe = NotebookDeck.safe(symbols, rule)
    let odds = analyse(safe, Observation(played: played,
      counts: @[Count(cards: safe, played: played - dangerPlayed)]))
    let expected = 10.0 * odds.chanceAtLeastOne(1, Danger)
    let netlist = "build/sim/chain.cir"
    mkDir "build/sim"
    writeFile(netlist, chainNetlist(stack, played, dangerPlayed))
    let (output, code) = gorgeEx("ngspice -b " & netlist)
    if code != 0: quit "ngspice failed:\n" & output
    let vp = measured(output, "vp")
    let errorPercent = abs(vp - expected) * 10.0   # % of 10 V full scale
    worst = max(worst, errorPercent)
    echo $symbols, (if blankSafe: " +blank-safe" else: ""), "  n=", played,
      " d=", dangerPlayed, "  lit=", card(litPositions(stack)),
      "  app ", round(expected * 10, 2), "%  circuit ", round(vp * 10, 2), "%"
  echo "worst error ", round(worst, 3), "% of full scale"
  if worst > 0.5: quit "circuit disagrees with the app"

proc spice(netlist, name: string): string =
  ## Writes `netlist` to build/sim/<name>.cir, runs ngspice, returns its output.
  mkDir "build/sim"
  let path = "build/sim/" & name & ".cir"
  writeFile(path, netlist)
  let (output, code) = gorgeEx("ngspice -b " & path)
  if code != 0: quit "ngspice failed on " & path & ":\n" & output
  output

proc csvRow(fields: varargs[string]): string = fields.join(",") & "\n"

task results, "Run every simulation and write hardware/results/":
  const dir = "hardware/results/"
  mkDir dir
  var report = "# Simulation results\n\n" &
    "Generated by `nim results` (needs `nim` and `ngspice`). Every number below comes " &
    "from the CSV files beside this report; every chart from those numbers.\n\n" &
    "Scale: 0.25 V per card, 10 V = 40 cards = 100 %. Errors are in % of full " &
    "scale (10 V), so 2.5 % = one card.\n\n"

  # ---- 1. divider accuracy -------------------------------------------------
  echo "divider accuracy sweep..."
  var csv = csvRow("cards_left", "danger_left", "expected_pct", "circuit_pct",
                   "error_pct_fs", "ripple_mv")
  var errors: seq[(float, float)]
  var worst = 0.0
  for cardsLeft in [1, 2, 3, 4, 5, 6, 8, 10, 13, 16, 20, 25, 30, 35, 40]:
    var seen: seq[int]
    for fraction in [0.0, 0.25, 0.5, 0.75, 1.0]:
      let dangerLeft = int(round(fraction * float(cardsLeft)))
      if dangerLeft in seen: continue
      seen.add dangerLeft
      let output = spice(dividerNetlist(dangerLeft, cardsLeft), "divider")
      let expected = 100.0 * float(dangerLeft) / float(cardsLeft)
      let circuit = 10.0 * measured(output, "vp")
      let error = circuit - expected
      worst = max(worst, abs(error))
      errors.add (float(cardsLeft), error)
      csv.add csvRow($cardsLeft, $dangerLeft, fixed(expected, 3), fixed(circuit, 4),
                     fixed(error, 4), fixed(1000 * measured(output, "ripple"), 3))
  writeFile(dir & "divider-accuracy.csv", csv)
  writeFile(dir & "divider-accuracy.svg", lineChart(
    "Divider error across the game",
    "Every simulated case: cards left 1–40 × danger 0/25/50/75/100 %. Dashed = no error.",
    Axis(label: "cards left", min: 0, max: 40),
    Axis(label: "error (% of full scale)", min: -0.1, max: 0.1, unit: "%"),
    @[Series(name: "divider", points: errors)], lines = false, dots = true,
    reference = @[(0.0, 0.0), (40.0, 0.0)]))
  report.add "## 1. Divider accuracy\n\n![Divider error](divider-accuracy.svg)\n\n" &
    $errors.len & " cases, cards left 1–40, danger 0–100 %. **Worst error " &
    fixed(worst, 3) & " % of full scale** (" & fixed(worst / 2.5, 3) &
    " of a card). Data: [divider-accuracy.csv](divider-accuracy.csv).\n\n"

  # ---- 2. divider settling -------------------------------------------------
  echo "divider settling..."
  var waves: seq[Series]
  var settleTimes = ""
  csv = csvRow("cards_left", "time_ms", "output_pct")
  for cardsLeft in [40, 10, 4, 2]:
    let wave = "build/sim/wave" & $cardsLeft & ".txt"
    discard spice(dividerNetlist(cardsLeft div 2, cardsLeft, wave), "settle")
    var points: seq[(float, float)]
    for (t, v) in readWave(wave):
      if t <= 0.300:
        points.add (t * 1000, v * 10)
        csv.add csvRow($cardsLeft, fixed(t * 1000, 3), fixed(v * 10, 4))
    waves.add Series(name: $cardsLeft & " cards left", points: points)
    var settled = 0.0          # last time the output was more than 0.1 % off
    for (t, v) in points:
      if abs(v - 50.0) > 0.1: settled = t
    settleTimes.add "- " & $cardsLeft & " cards left: within 0.1 % after " &
      fixed(settled, 0) & " ms\n"
  writeFile(dir & "divider-settling.csv", csv)
  writeFile(dir & "divider-settling.svg", lineChart(
    "Divider settling after power-up",
    "Output vs time, all four cases targeting 50 %. Dashed = target.",
    Axis(label: "time (ms)", min: 0, max: 300, unit: " ms"),
    Axis(label: "output (%)", min: 0, max: 100, unit: "%"),
    waves, reference = @[(0.0, 50.0), (300.0, 50.0)]))
  report.add "## 2. Divider settling\n\n![Divider settling](divider-settling.svg)\n\n" &
    settleTimes & "\nThe 2-pole output filter dominates. With few cards left the " &
    "loop itself is slower (time constant 40 ms ÷ cards left): it starts at full " &
    "duty, so the output rises faster and overshoots a little before settling. " &
    "Either way it's under a fifth of a second. Data: " &
    "[divider-settling.csv](divider-settling.csv).\n\n"

  # ---- 3. whole chain vs the app ------------------------------------------
  echo "whole chain vs app..."
  const scenarios = [
    ({Void}, false, 0, 0),
    ({Void, Caves}, true, 10, 3),
    ({Rocky, Desert, Caves}, false, 20, 5),
    ({Ruins}, true, 37, 1),
    ({Void .. Desert}, false, 0, 0),
    ({Hostile, Crystalline}, false, 30, 27)]
  csv = csvRow("scenario", "plates", "blank_safe", "cards_played", "danger_played",
               "lit_positions", "app_pct", "circuit_pct", "error_pct_fs")
  var appSeries, circuitSeries: seq[(float, float)]
  var labels: seq[string]
  var table = "| # | Plates stacked | n | d | Lit | App | Circuit |\n|---|---|---|---|---|---|---|\n"
  worst = 0.0
  for i, (symbols, blankSafe, played, dangerPlayed) in scenarios:
    var stack: seq[Plate]
    var names: seq[string]
    for symbol in symbols:
      stack.add plateFor(symbol)
      names.add $symbol
    if blankSafe: stack.add blankSafePlate()
    let rule = if blankSafe: blankIsSafe else: blankIsDanger
    let safe = NotebookDeck.safe(symbols, rule)
    let odds = analyse(safe, Observation(played: played,
      counts: @[Count(cards: safe, played: played - dangerPlayed)]))
    let app = 100.0 * odds.chanceAtLeastOne(1, Danger)
    let circuit = 10.0 * measured(spice(chainNetlist(stack, played, dangerPlayed), "chain"), "vp")
    worst = max(worst, abs(circuit - app))
    let plateList = (if names.len == 12: "all 12" else: names.join(" + ")) &
      (if blankSafe: " + blank-safe" else: "")
    labels.add "#" & $(i + 1)
    appSeries.add (float(i), app)
    circuitSeries.add (float(i), circuit)
    csv.add csvRow($(i + 1), "\"" & plateList & "\"", $blankSafe, $played, $dangerPlayed,
                   $card(litPositions(stack)), fixed(app, 3), fixed(circuit, 3),
                   fixed(circuit - app, 4))
    table.add "| " & $(i + 1) & " | " & plateList & " | " & $played & " | " & $dangerPlayed &
      " | " & $card(litPositions(stack)) & " | " & fixed(app, 2) & " % | " &
      fixed(circuit, 2) & " % |\n"
  writeFile(dir & "chain-vs-app.csv", csv)
  writeFile(dir & "chain-vs-app.svg", barChart(
    "Whole analog chain vs the app",
    "Plates → 40 detector bits → popcount → DACs → subtractors → divider, in ngspice.",
    labels, Axis(label: "danger chance, next card (%)", min: 0, max: 100, unit: "%"),
    @[Series(name: "app (odds.nim)", points: appSeries),
      Series(name: "circuit (ngspice)", points: circuitSeries)],
    xAxisLabel = "scenario (see table)"))
  report.add "## 3. Whole chain vs the app\n\n![Chain vs app](chain-vs-app.svg)\n\n" &
    table & "\nn = cards played, d = danger cards played, Lit = detector positions " &
    "lit by the stack. **Worst disagreement " & fixed(worst, 3) &
    " % of full scale.** Ideal op-amps; resistor tolerance is section 4. Data: " &
    "[chain-vs-app.csv](chain-vs-app.csv).\n\n"

  # ---- 4. resistor tolerance Monte Carlo ----------------------------------
  echo "resistor tolerance Monte Carlo..."
  const
    trials = 500
    mcPlayed = 30
    mcDangerPlayed = 24
  let mcStack = @[plateFor(Void)]                  # 32 danger cards
  let mcExpected = 100.0 * float(32 - mcDangerPlayed) / float(40 - mcPlayed)
  const bins = 31
  const binWidth = 0.1                              # % of full scale
  # (label, counting resistors, gain-setting pairs, seed, histogram?)
  const configs = [
    ("1 % everywhere", 0.01, 0.01, 2, false),
    ("0.1 % everywhere", 0.001, 0.001, 1, true),
    ("0.1 % + 0.01 % matched pairs", 0.001, 0.0001, 3, true)]
  var histograms: seq[Series]
  csv = csvRow("config", "trial", "error_pct_fs")
  var spread = "| Resistors | SD | Worst of " & $trials & " | Worst, in cards |\n|---|---|---|---|\n"
  for (name, tolerance, pairTolerance, seed, plotted) in configs:
    let output = spice(toleranceNetlist(mcStack, mcPlayed, mcDangerPlayed,
                                        tolerance, pairTolerance, trials, seed), "tolerance")
    let values = printedValues(output)
    var counts = newSeq[float](bins)
    var worstHere, sum, sumSquares = 0.0
    for trial in 0 ..< trials:
      let error = 100.0 * values["v(vnum_" & $trial & ")"] /
                  values["v(vden_" & $trial & ")"] - mcExpected
      worstHere = max(worstHere, abs(error))
      sum += error
      sumSquares += error * error
      csv.add csvRow("\"" & name & "\"", $trial, fixed(error, 4))
      counts[clamp(int(floor(error / binWidth + bins / 2)), 0, bins - 1)] += 1
    let mean = sum / float(trials)
    let sd = sqrt(sumSquares / float(trials) - mean * mean)
    spread.add "| " & name & " | " & fixed(sd, 3) & " % | " & fixed(worstHere, 3) &
      " % | " & fixed(worstHere / 2.5, 2) & " |\n"
    if plotted:
      var points: seq[(float, float)]
      for b, count in counts: points.add (float(b), count)
      histograms.add Series(name: name, points: points)
  var binLabels: seq[string]
  for b in 0 ..< bins:
    binLabels.add fixed((float(b) - float(bins div 2)) * binWidth, 1)
  writeFile(dir & "resistor-tolerance.csv", csv)
  writeFile(dir & "resistor-tolerance.svg", barChart(
    "Resistor tolerance late in the game",
    "500 random builds each. Void stacked, 30 played, 24 danger played: 8 of 10 left = 80 %.",
    binLabels, Axis(label: "builds", min: 0, max: 150, unit: ""),
    histograms, xAxisLabel = "error (% of full scale; edge bins include everything beyond)",
    labelEvery = 5))
  report.add "## 4. Resistor tolerance (Monte Carlo)\n\n" &
    "![Resistor tolerance](resistor-tolerance.svg)\n\n" &
    "Every resistor in M4–M6 is drawn uniformly within its tolerance; op-amps are " &
    "ideal. The case is late in the game (10 cards left): the circuit subtracts " &
    "nearly equal large voltages there (8 V − 6 V, 10 V − 7.5 V), so a 0.1 % gain " &
    "error on 8 V becomes 0.4 % of a 2 V difference. Matched 0.01 % networks for " &
    "the gain-setting pairs (×2 amps, DAC feedback and inverters, difference amps) " &
    "fix most of it; the 40 counting resistors and the DAC weights can stay 0.1 %.\n\n" &
    spread & "\n1 % parts aren't plotted: their spread is far off this scale. Data: " &
    "[resistor-tolerance.csv](resistor-tolerance.csv).\n\n"

  # ---- 5. unit tests ------------------------------------------------------
  echo "unit tests..."
  var testLog = ""
  for test in ["tests/test_odds.nim", "tests/test_plates.nim"]:
    let (output, code) = gorgeEx("nim c -r --hints:off --outdir:build/tests " & test)
    for line in output.splitLines:
      if "[OK]" in line or "[FAILED]" in line or "[Suite]" in line: testLog.add line & "\n"
    if code != 0: quit "unit tests failed:\n" & output
  writeFile(dir & "unit-tests.txt", testLog)
  report.add "## 5. Unit tests\n\nIncluding the optics check: every one of the 8190 " &
    "plate stacks lights exactly the app's danger cards. Log: " &
    "[unit-tests.txt](unit-tests.txt).\n\n" &
    "## Reproduce\n\n```\nnim results   # this report\nnim sim       # quick chain check only\n" &
    "nim test      # unit tests\n```\n\nNetlists are written to `build/sim/` while it runs. " &
    "The stand-alone divider netlist is `hardware/sim/divider.cir`.\n"
  writeFile(dir & "README.md", report)
  echo "wrote ", dir

task icons, "Trace the biome icons from hardware/icons/source/ into hardware/icons/":
  # Each icon is 64 px square in the source, in a column at x = 56..119. These
  # are the top edges, found by scanning that column for dark rows. Tutorial
  # isn't in this deck, so it's skipped.
  const
    source = "hardware/icons/source/biome-icons.png"
    iconTops = [(Caves, 182), (Crystalline, 250), (Deadly, 369), (Desert, 550),
                (Frigid, 618), (Hostile, 796), (Rocky, 919), (Ruins, 1042),
                (Vegetation, 1342), (Void, 1465), (Volcanic, 1643), (Water, 1766)]
  mkDir "build/icons"
  for (symbol, top) in iconTops:
    let name = toLowerAscii($symbol)
    let bitmap = "build/icons/" & name & ".pbm"
    # 66 px crop with a pixel of margin, upscale 8x with smoothing so the
    # trace gets curves rather than pixel steps, then threshold to 1 bit.
    exec "convert " & source & " -crop 66x66+55+" & $(top - 1) &
      " +repage -colorspace gray -resize 800% -threshold 50% " & bitmap
    exec "potrace " & bitmap & " --svg --flat --turdsize 40 --alphamax 1.1" &
      " -o hardware/icons/" & name & ".svg"
  echo "traced ", iconTops.len, " icons to hardware/icons/"
